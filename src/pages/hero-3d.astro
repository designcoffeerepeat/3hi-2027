---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import Work from '../components/Work.astro';
import Clients from '../components/Clients.astro';
import Intro from '../components/Intro.astro';
import Services from '../components/Services.astro';
import Method from '../components/Method.astro';
import AiScan from '../components/AiScan.astro';
import Testimonials from '../components/Testimonials.astro';
import Insights from '../components/Insights.astro';

// Preview of the homepage with the 3D 'xt' hero in place of the clock.
// All copy comes from src/content/pages/home.md
const page = (await getEntry('pages', 'home'))!.data as any;
---
<Base title={page.seo.title} description={page.seo.description} noindex>
  <Story hero={page.hero} spotlight={page.spotlight} variant="3d" />
  <Work work={page.work} />
  <Clients clients={page.clients} />
  <Intro intro={page.intro} />
  <Services services={page.services} />
  <Method method={page.method} />
  <AiScan scan={page.scan} variant="clock" />
  <Testimonials testimonials={page.testimonials} />
  <Insights insights={page.insights} />
</Base>
