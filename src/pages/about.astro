---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Overline from '../components/Overline.astro';
import Three from '../components/Three.astro';
import XtMark from '../components/XtMark.astro';
import Icon from '../components/Icon.astro';
import Clients from '../components/Clients.astro';
import Testimonials from '../components/Testimonials.astro';

// Copy comes from src/content/pages/about.md. The stats and client names
// are shared with the home page.
const page = (await getEntry('pages', 'about'))!.data as any;
const home = (await getEntry('pages', 'home'))!.data as any;
const words = page.hero.title.split(' ');
---
<Base title={page.seo.title} description={page.seo.description}>
  <section class="ab-hero" aria-labelledby="ab-title">
    <span class="ab-hero__sun" aria-hidden="true"></span>
    <Three id="ab-three" class="ab-hero__three" />
    <XtMark class="ab-hero__xt" />
    <div class="ab-hero__left">
      <p class="mono ab-hero__overline">{page.hero.overline}</p>
      <h1 id="ab-title" class="ab-hero__title">
        {words.map((w: string, i: number) => <>{i > 0 && ' '}<span style={`--i:${i}`}>{w}</span></>)}
      </h1>
      <a class="ab-hero__down" href="#visual" aria-label="Scroll down">
        <span class="mono" aria-hidden="true">{page.hero.arrowLabel}</span>
        <svg viewBox="0 0 44 99" fill="none" aria-hidden="true">
          <path d="M21.7731 1.5L21.7731 97.5M2.12126 77.8484L21.7731 97.5L41.4248 77.8485" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
    <div class="ab-hero__copy" data-reveal style="--reveal-delay:300ms">
      <p class="ab-hero__kicker">{page.hero.kicker}</p>
      <p>{page.hero.text}</p>
      <Button href={page.hero.button.href} label={page.hero.button.label} />
    </div>
  </section>

  <section class="ab-visual" id="visual" aria-label={page.visual.caption}>
    {page.visual.video ? (
      <video src={page.visual.video} poster={page.visual.image} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
    ) : (
      <img src={page.visual.image} alt={page.visual.imageAlt} width="1920" height="900" loading="lazy" decoding="async" data-speed="-0.1" />
    )}
    <p class="ab-visual__caption mono">{page.visual.caption}</p>
  </section>

  <section class="ab-story" id="story" aria-labelledby="ab-story-title">
    <div class="ab-story__top">
      <Overline text={page.story.overline} />
      <div class="ab-story__copy">
        <h2 id="ab-story-title" class="ab-story__title" data-reveal>{page.story.title}</h2>
        <p class="ab-story__text" data-reveal style="--reveal-delay:120ms">{page.story.text}</p>
      </div>
    </div>
    <div class="ab-stats">
      {home.intro.stats.map((s: any, i: number) => (
        <div class="ab-stat" data-reveal style={`--reveal-delay:${i * 100}ms`}>
          <p class="display-l">{s.value}</p>
          <p class="mono">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="ab-why" aria-labelledby="ab-why-title">
    <Overline text={page.why.overline} tone="paper" />
    <h2 id="ab-why-title" class="ab-big" data-reveal>{page.why.title}</h2>
    <div class="ab-why__grid">
      {page.why.items.map((w: any, i: number) => (
        <div class="ab-why__item" data-reveal style={`--reveal-delay:${i * 110}ms`}>
          <p class="ab-why__num grad-text">{w.number}</p>
          <h3>{w.title}</h3>
          <p class="ab-why__text">{w.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="ab-awards" aria-labelledby="ab-awards-title">
    <Overline text={page.awards.overline} />
    <h2 id="ab-awards-title" class="ab-big" data-reveal>{page.awards.title}</h2>
    <ul class="ab-awards__list">
      {page.awards.items.map((a: any) => (
        <li class="ab-award" data-reveal>
          <span class="mono">{a.year}</span>
          <span class="ab-award__title">{a.title}</span>
          <span class="ab-award__cat">{a.category}</span>
          <Icon name="arrow" size={16} />
        </li>
      ))}
    </ul>
  </section>

  <Clients clients={home.clients} />
  <Testimonials testimonials={page.testimonials} />
</Base>

<style>
  .ab-hero {
    --u: min(calc(100vw / 1920), calc(100svh / 1080));
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    min-height: 100svh;
    padding: calc(var(--header-h) + 40px) var(--gutter) 60px;
    overflow: hidden;
  }

  .ab-hero__sun {
    position: absolute;
    left: -15vw;
    bottom: -45vw;
    width: 70vw;
    height: 70vw;
    border-radius: 50%;
    background: radial-gradient(circle at 25% 75%, #ff975e, #ffd600 48%, #ffc5fe);
    filter: blur(90px);
    opacity: 0.45;
    pointer-events: none;
  }

  .ab-hero :global(.ab-hero__three) {
    position: absolute;
    left: 33%;
    top: calc(var(--header-h) + 20px);
    width: min(42vw, calc(78svh * 1031 / 1265));
    animation: ab-in 1.6s var(--ease-out) 0.2s both;
  }

  .ab-hero :global(.ab-hero__xt) {
    position: absolute;
    right: calc(var(--gutter) + 6vw);
    top: calc(var(--header-h) + 30px);
    width: clamp(120px, 11.5vw, 220px);
    color: var(--ink);
  }

  @keyframes ab-in {
    from {
      opacity: 0;
      transform: translate3d(0, 8%, 0) rotate(-6deg);
    }
  }

  .ab-hero__left {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-height: calc(100svh - var(--header-h) - 100px);
  }

  .ab-hero__title {
    max-width: 6.5em;
    font-weight: 600;
    font-size: clamp(52px, 7.03vw, 135px);
    line-height: 0.88;
    text-transform: uppercase;
  }

  .ab-hero__title span {
    display: inline-block;
    animation: ab-word 1.1s var(--ease-out) both;
    animation-delay: calc(0.1s + var(--i) * 0.07s);
  }

  @keyframes ab-word {
    from {
      opacity: 0;
      transform: translate3d(0, 0.5em, 0);
    }
  }

  .ab-hero__down {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 32px;
    margin-top: auto;
  }

  .ab-hero__down .mono {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-size: 10px;
    white-space: nowrap;
  }

  .ab-hero__down svg {
    width: 26px;
    animation: ab-bob 2.4s ease-in-out infinite;
  }

  @keyframes ab-bob {
    50% {
      translate: 0 8px;
    }
  }

  .ab-hero__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    width: min(419px, 100%);
    margin-top: clamp(200px, 20vw, 380px);
  }

  .ab-hero__kicker {
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .ab-visual {
    position: relative;
    height: min(46.875vw, 100svh);
    min-height: 360px;
    overflow: hidden;
    background: var(--ink);
  }

  .ab-visual img,
  .ab-visual video {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    max-width: none;
    object-fit: cover;
  }

  .ab-visual img {
    animation: ab-pan 30s ease-in-out infinite alternate;
  }

  @keyframes ab-pan {
    to {
      scale: 1.08;
    }
  }

  .ab-visual__caption {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(24px, 3vw, 60px);
    color: var(--sun);
  }

  .ab-story {
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 6.25vw, 120px);
    padding: clamp(96px, 8.3vw, 160px) var(--gutter);
  }

  .ab-story__top {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(32px, 6.25vw, 120px);
    padding-inline: clamp(0px, 7vw, 140px) 0;
  }

  .ab-story__copy {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 1400px;
  }

  .ab-story__title {
    font-weight: 600;
    font-size: var(--fs-heading-xl);
    line-height: 1.2;
  }

  .ab-story__text {
    font-size: clamp(17px, 1.25vw, 24px);
    line-height: 1.8;
  }

  .ab-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }

  .ab-stat {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }

  .ab-stat .mono {
    line-height: 1.2;
  }

  .ab-big {
    font-weight: 400;
    font-size: clamp(48px, 6.25vw, 120px);
    line-height: 1;
    text-transform: uppercase;
  }

  .ab-why {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: clamp(96px, 7.3vw, 140px) var(--gutter);
    background: var(--ink);
    color: var(--paper);
  }

  .ab-why__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 30px;
  }

  .ab-why__item {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 28px;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }

  .ab-why__num {
    width: fit-content;
    font-weight: 600;
    font-size: clamp(64px, 6.25vw, 120px);
    line-height: 1;
  }

  .ab-why__item h3 {
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  .ab-why__text {
    font-size: var(--fs-body-m);
    line-height: 1.8;
  }

  .ab-awards {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: clamp(96px, 7.3vw, 140px) var(--gutter-wide);
  }

  .ab-awards__list {
    margin-top: 30px;
    border-bottom: 1px solid #e3e3e0;
  }

  .ab-award {
    display: grid;
    grid-template-columns: 1fr 2.5fr 1.5fr auto;
    align-items: center;
    gap: 24px;
    padding: 34px 0;
    border-top: 1px solid #e3e3e0;
    transition: padding 0.4s var(--ease-out);
  }

  .ab-award:hover {
    padding-inline: 16px;
  }

  .ab-award__title {
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  .ab-award__cat {
    font-size: 15px;
    color: var(--ink-60);
  }

  @media (max-width: 899px) {
    .ab-hero {
      flex-direction: column;
    }

    .ab-hero :global(.ab-hero__three) {
      left: auto;
      right: -20vw;
      top: calc(var(--header-h) + 22svh);
      width: 80vw;
      opacity: 0.6;
    }

    .ab-hero :global(.ab-hero__xt) {
      display: none;
    }

    .ab-hero__left {
      min-height: 0;
    }

    .ab-hero__down {
      display: none;
    }

    .ab-hero__copy {
      margin-top: auto;
    }

    .ab-story__top {
      grid-template-columns: 1fr;
      padding: 0;
    }

    .ab-stats {
      grid-template-columns: 1fr 1fr;
      row-gap: 48px;
    }

    .ab-why__grid {
      grid-template-columns: 1fr;
    }

    .ab-award {
      grid-template-columns: auto 1fr;
    }

    .ab-award__cat,
    .ab-award :global(svg) {
      display: none;
    }
  }
</style>
