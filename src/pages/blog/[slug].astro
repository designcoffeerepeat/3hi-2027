---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Overline from '../../components/Overline.astro';
import Insights from '../../components/Insights.astro';
import AiScan from '../../components/AiScan.astro';
import { getPosts } from '../../lib/content';

// One page per file in src/content/posts. The table of contents is built
// from the article's ## headings.
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, posts } }));
}

const { entry, posts } = Astro.props;
const p = entry.data as any;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const home = (await getEntry('pages', 'home'))!.data as any;
const others = posts.filter((o: any) => o.id !== entry.id).slice(0, 3);
const keep = {
  overline: 'Insights',
  title: 'Keep reading',
  button: home.insights.button,
  posts: others.map((o: any) => ({
    tag: `${o.data.categoryLabel}  /  ${o.data.readTime}`,
    title: o.data.title,
    image: o.data.image,
    imageAlt: o.data.imageAlt,
    href: `/blog/${o.id}`,
  })),
};
const url = new URL(Astro.url.pathname, Astro.site ?? 'https://3h-i.com').href;
---
<Base title={`${p.title} | 3 Horizons Interactive`} description={p.excerpt}>
  <div class="progress" aria-hidden="true"><span data-read-progress></span></div>
  <article class="post">
    <header class="post-hero">
      <a class="post-hero__back mono" href="/blog">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true"><path d="M16 10H4M9 5L4 10L9 15" stroke="currentColor" stroke-width="1.6" /></svg>
        All articles
      </a>
      <Overline text={`${p.categoryLabel}  /  ${p.readTime}`} />
      <h1 class="post-hero__title">{p.title}</h1>
      <p class="post-hero__deck">{p.excerpt}</p>
      <div class="post-hero__byline">
        <p class="byline"><span class="byline__dot" aria-hidden="true"></span><span><strong>3 Horizons Interactive</strong><br />Strategy team  /  Los Angeles & New York</span></p>
        <div class="share">
          <a class="share__pill label" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">LinkedIn</a>
          <a class="share__pill label" href={`https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(p.title)}`} target="_blank" rel="noopener">X</a>
          <button class="share__pill label" type="button" data-copy-link data-done="Link copied">Copy link</button>
        </div>
      </div>
    </header>

    <figure class="post-shot">
      <img src={p.heroImage ?? p.image} alt={p.heroImageAlt ?? p.imageAlt} width="1920" height="900" decoding="async" fetchpriority="high" />
      {p.caption && <figcaption>{p.caption}</figcaption>}
    </figure>

    <div class="post-body">
      {toc.length > 0 && (
        <nav class="toc" aria-label="In this article">
          <p class="mono">In this article</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}
            {p.takeaways && <li><a href="#key-takeaways" data-toc="key-takeaways">Key takeaways</a></li>}
          </ol>
        </nav>
      )}
      <div class="prose" data-prose>
        <Content />
        {p.takeaways && (
          <aside class="takeaways" id="key-takeaways">
            <h2>Key takeaways</h2>
            <ul>{p.takeaways.map((t: string) => <li>{t}</li>)}</ul>
          </aside>
        )}
        {p.tags && (
          <ul class="tags" aria-label="Tags">{p.tags.map((t: string) => <li class="label">{t}</li>)}</ul>
        )}
        <div class="author">
          <span class="byline__dot" aria-hidden="true"></span>
          <div>
            <p class="mono">Written by the 3 Horizons Interactive team</p>
            <p class="author__text">Storytellers, designers and strategists in Los Angeles and New York.</p>
          </div>
        </div>
      </div>
    </div>
  </article>

  <Insights insights={keep} />
  <AiScan scan={home.scan} />
</Base>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 4px;
    background: #dadad6;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--sun);
    transform: scaleX(0);
    transform-origin: left;
  }

  .post-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(20px, 2.08vw, 40px);
    padding: calc(var(--header-h) + clamp(24px, 5.2vw, 100px)) var(--gutter-wide) clamp(48px, 4.4vw, 86px);
  }

  .post-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }

  .post-hero__back:hover {
    color: var(--ink-60);
  }

  .post-hero__title {
    max-width: 1400px;
    font-weight: 600;
    font-size: clamp(40px, 5.21vw, 100px);
    line-height: 0.95;
    text-transform: uppercase;
    animation: post-up 1.2s var(--ease-out) both;
  }

  @keyframes post-up {
    from {
      opacity: 0;
      transform: translate3d(0, 0.3em, 0);
    }
  }

  .post-hero__deck {
    max-width: 1100px;
    font-size: clamp(18px, 1.354vw, 26px);
    line-height: 1.6;
  }

  .post-hero__byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding-top: 30px;
    border-top: 1px solid #dadad6;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 15px;
    line-height: 1.5;
  }

  .byline__dot {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--sun);
  }

  .share {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .share__pill {
    padding: 14px 22px;
    border: 1px solid var(--ink);
    border-radius: 300px;
    background: none;
    font-size: 12px;
    cursor: pointer;
    transition: background-color 0.3s;
  }

  .share__pill:hover {
    background: var(--sun);
  }

  .post-shot img {
    width: 100%;
    height: auto;
  }

  .post-shot figcaption {
    padding: 16px var(--gutter-wide) 0;
    font-size: 13px;
    color: var(--ink-60);
  }

  .post-body {
    display: grid;
    grid-template-columns: 360px minmax(0, 900px);
    gap: clamp(40px, 6.25vw, 120px);
    padding: clamp(64px, 6.25vw, 120px) var(--gutter-wide) clamp(80px, 7.3vw, 140px);
  }

  .toc {
    position: sticky;
    top: 140px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 30px;
    border-radius: 20px;
    background: var(--mist);
  }

  .toc ol {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }

  .toc li {
    counter-increment: toc;
    display: flex;
    gap: 14px;
    font-size: 16px;
    line-height: 1.5;
  }

  .toc li::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 12px;
    padding-top: 3px;
    color: var(--ink-60);
  }

  .toc a {
    transition: color 0.3s;
  }

  .toc a.is-active {
    font-weight: 600;
  }

  .toc a:hover {
    color: var(--ink-60);
  }

  .prose {
    font-size: clamp(17px, 1.146vw, 22px);
    line-height: 1.8;
  }

  .prose :global(h2) {
    margin: 2em 0 0.8em;
    font-weight: 600;
    font-size: clamp(26px, 1.875vw, 36px);
    line-height: 1.25;
    scroll-margin-top: 140px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin: 0 0 1.2em;
  }

  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding-left: 34px;
    border-left: 6px solid var(--sun);
    font-size: clamp(24px, 2.08vw, 40px);
    line-height: 1.3;
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    margin: 1.4em 0;
  }

  .prose :global(ol) {
    margin: 0 0 1.4em;
    padding: 0;
    list-style: none;
    counter-reset: steps;
  }

  .prose :global(ol li) {
    position: relative;
    counter-increment: steps;
    padding-left: 44px;
    margin-bottom: 0.9em;
  }

  .prose :global(ol li::before) {
    content: counter(steps, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.2em;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-60);
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--sun);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .takeaways {
    margin: 2em 0;
    padding: clamp(28px, 2.6vw, 50px);
    border-radius: 24px;
    background: var(--mist);
    scroll-margin-top: 140px;
  }

  .takeaways h2 {
    margin: 0 0 0.8em !important;
    font-size: clamp(22px, 1.5625vw, 30px) !important;
  }

  .takeaways li {
    position: relative;
    padding-left: 28px;
    margin-top: 0.6em;
  }

  .takeaways li::before {
    content: '+';
    position: absolute;
    left: 0;
    font-weight: 600;
    color: var(--ink);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 30px;
    border-bottom: 1px solid #c8c8c4;
  }

  .tags li {
    padding: 10px 18px;
    border-radius: 300px;
    background: var(--mist);
    font-size: 11px;
  }

  .author {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .author .mono {
    font-size: 12px;
    line-height: 1.4;
  }

  .author__text {
    margin-top: 8px;
    font-size: 14px;
    color: var(--ink-60);
  }

  @media (max-width: 1100px) {
    .post-body {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
    }
  }
</style>

<script>
  /* Reading progress and the active table of contents entry */
  const bar = document.querySelector<HTMLElement>('[data-read-progress]');
  const prose = document.querySelector<HTMLElement>('[data-prose]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const targets = links.map((l) => document.getElementById(l.dataset.toc!)).filter(Boolean) as HTMLElement[];
  function update() {
    if (bar && prose) {
      const r = prose.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.5 - r.top) / r.height));
      bar.style.transform = `scaleX(${p})`;
    }
    let current = '';
    for (const t of targets) if (t.getBoundingClientRect().top < window.innerHeight * 0.35) current = t.id;
    links.forEach((l) => l.classList.toggle('is-active', l.dataset.toc === current));
    requestAnimationFrame(update);
  }
  requestAnimationFrame(update);

  document.querySelector<HTMLButtonElement>('[data-copy-link]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(window.location.href);
      const before = btn.textContent;
      btn.textContent = btn.dataset.done ?? 'Copied';
      setTimeout(() => (btn.textContent = before), 2000);
    } catch {
      window.prompt('Copy this link', window.location.href);
    }
  });
</script>
