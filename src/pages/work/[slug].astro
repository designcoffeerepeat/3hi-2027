---
import Base from '../../layouts/Base.astro';
import Overline from '../../components/Overline.astro';
import PrevNext from '../../components/PrevNext.astro';
import { getCases } from '../../lib/content';

// One page per file in src/content/work. Previous and Next wrap around the
// list, so the first case study links back to the last one.
export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: cases[(i - 1 + cases.length) % cases.length],
      next: cases[(i + 1) % cases.length],
    },
  }));
}

const { entry, prev, next } = Astro.props;
const c = entry.data as any;
const g = c.gallery;
// Gallery pieces are sized against the 1680px content width of the artboard
const pct = (w: number) => `${((w / 1680) * 100).toFixed(3)}%`;
const px = (v: number) => `min(${v}px, ${((v / 1920) * 100).toFixed(3)}vw)`;
---
<Base title={`${c.title} case study | 3 Horizons Interactive`} description={c.subtitle}>
  <article class="cs">
    <header class="cs-hero">
      <Overline text={c.overline} class="cs-hero__overline" />
      <h1 class:list={['cs-hero__title', `cs-hero__title--${c.titleSize ?? 'xxl'}`]}>{c.title}</h1>
      <p class="cs-hero__sub" data-reveal>{c.subtitle}</p>
      <dl class="cs-meta" data-reveal style="--reveal-delay:120ms">
        {c.meta.map((m: any) => (
          <div class="cs-meta__item">
            <dt class="mono">{m.label}</dt>
            <dd>{m.href ? <a href={m.href} target="_blank" rel="noopener">{m.value}</a> : m.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <figure class="cs-shot">
      <img src={c.hero.src} alt={c.hero.alt} width={c.hero.width} height={c.hero.height} decoding="async" fetchpriority="high" />
    </figure>

    <section class="cs-story" aria-label="The challenge and our approach">
      <div class="cs-row" data-reveal>
        <h2 class="cs-row__title">The challenge</h2>
        <p class="cs-row__text">{c.challenge}</p>
      </div>
      <div class="cs-row" data-reveal>
        <h2 class="cs-row__title">Our approach</h2>
        <p class="cs-row__text">{c.approach}</p>
      </div>
      <ul class="cs-bullets">
        {c.bullets.map((b: any, i: number) => (
          <li class="cs-bullet" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <p class="cs-bullet__title"><span aria-hidden="true"></span>{b.title}</p>
            <p class="cs-bullet__text">{b.text}</p>
          </li>
        ))}
      </ul>
    </section>

    {g && (
      <section class:list={['cs-gallery', { 'cs-gallery--full': g.full }]} aria-label="Project gallery">
        {g.full ? (
          <img src={g.full.src} alt={g.full.alt} width={g.full.width} height={g.full.height} loading="lazy" decoding="async" />
        ) : (
          <div class="cs-rows">
            <div class="cs-cols">
              {g.columns.map((col: any) => (
                <div class="cs-col" style={`width:${pct(col.width)};gap:${px(col.gap ?? 100)}`}>
                  {col.items.map((it: any) => (
                    <div class="cs-piece" data-reveal>
                      <img src={it.src} alt={it.alt} width={it.width} height={it.height} loading="lazy" decoding="async" />
                      {it.overlay && (
                        <img
                          class="cs-piece__over"
                          src={it.overlay.src}
                          alt={it.overlay.alt}
                          width={it.overlay.width}
                          height={it.overlay.height}
                          loading="lazy"
                          decoding="async"
                          style={`left:${it.overlay.left}%;top:${it.overlay.top}%;width:${it.overlay.size}%`}
                        />
                      )}
                    </div>
                  ))}
                </div>
              ))}
            </div>
            {g.after?.map((it: any) => (
              <img class="cs-after" src={it.src} alt={it.alt} width={it.width} height={it.height} loading="lazy" decoding="async" style={`width:${pct(it.size)};margin-top:${px(100)}`} data-reveal />
            ))}
          </div>
        )}
      </section>
    )}

    <section class="cs-results" aria-labelledby="cs-results-title">
      <Overline text="Results" tone="paper" />
      <h2 id="cs-results-title" class="cs-results__title" data-reveal>The outcome</h2>
      <div class="cs-stats">
        {c.results.stats.map((s: any, i: number) => (
          <div class="cs-stat" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <p class="cs-stat__value grad-text">{s.value}</p>
            <p class="mono">{s.label}</p>
          </div>
        ))}
      </div>
      <div class="cs-sum">
        <p class="cs-sum__text" data-reveal>{c.results.summary}</p>
        <div class="cs-sum__list" data-reveal style="--reveal-delay:120ms">
          <ul>
            {c.results.items.map((r: string) => <li>{r}</li>)}
          </ul>
          <p class="cs-sum__note">{c.results.note}</p>
        </div>
      </div>
    </section>

    <figure class="cs-quote">
      <span class="cs-quote__mark" aria-hidden="true">“</span>
      <blockquote data-reveal>{c.quote.text}</blockquote>
      <figcaption>
        <span class="label">{c.quote.name}</span>
        <span class="cs-quote__rule" aria-hidden="true"></span>
        <span>{c.quote.role}</span>
      </figcaption>
    </figure>
  </article>

  <PrevNext prev={prev} next={next} />
</Base>

<style>
  .cs-hero {
    display: flex;
    flex-direction: column;
    padding: calc(var(--header-h) + clamp(32px, 6.25vw, 120px)) var(--gutter) clamp(48px, 3.125vw, 60px);
  }

  .cs-hero__title {
    margin: clamp(16px, 1.56vw, 30px) 0 clamp(20px, 2.08vw, 40px);
    font-weight: 400;
    font-size: var(--fs-display-xxl);
    line-height: 0.9;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    animation: cs-up 1.2s var(--ease-out) both;
  }

  .cs-hero__title--l {
    font-size: clamp(48px, 10.42vw, 200px);
  }

  .cs-hero__title--xl {
    font-size: clamp(44px, 9.375vw, 180px);
  }

  @keyframes cs-up {
    from {
      opacity: 0;
      transform: translate3d(0, 0.3em, 0);
    }
  }

  .cs-hero__sub {
    max-width: 1100px;
    font-weight: 600;
    font-size: clamp(24px, 2.5vw, 48px);
    line-height: 1.25;
  }

  .cs-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px 40px;
    margin: clamp(40px, 3.125vw, 60px) 0 0;
    padding-top: 30px;
    border-top: 2px solid #c8c8c4;
  }

  .cs-meta dt {
    color: var(--ink-60);
    margin-bottom: 14px;
  }

  .cs-meta dd {
    margin: 0;
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  .cs-meta a:hover {
    text-decoration: underline;
    text-decoration-color: var(--sun);
    text-underline-offset: 6px;
  }

  .cs-shot {
    background: var(--ink);
  }

  .cs-shot img {
    width: 100%;
    height: auto;
  }

  .cs-story {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 4.2vw, 80px);
    padding: clamp(80px, 6.25vw, 120px) var(--gutter) clamp(80px, 7.3vw, 140px);
  }

  .cs-row,
  .cs-bullet {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 1120px);
    justify-content: space-between;
    gap: 24px 60px;
  }

  .cs-row__title {
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: 1.2;
    text-transform: uppercase;
  }

  .cs-row__text {
    font-size: clamp(17px, 1.354vw, 26px);
    line-height: 1.7;
  }

  .cs-bullets {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 2.6vw, 50px);
  }

  .cs-bullet__title {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3.125vw, 60px);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  .cs-bullet__title span {
    flex: none;
    width: clamp(40px, 4.4vw, 85px);
    height: 1px;
    background: var(--ink);
  }

  .cs-bullet__text {
    position: relative;
    padding-left: 30px;
    font-weight: 600;
    font-size: clamp(16px, 1.354vw, 26px);
    line-height: 1.7;
  }

  .cs-bullet__text::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 10px;
    height: 10px;
    background: var(--sun);
  }

  .cs-gallery {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(48px, 6.25vw, 120px) var(--gutter-gal, 6.25vw);
    background: var(--mist);
  }

  .cs-gallery--full {
    padding: 0;
  }

  .cs-gallery--full img {
    width: 100%;
    height: auto;
  }

  /* Rows stop growing at 1600px so ultrawide screens keep the layout */
  .cs-rows {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 1600px;
  }

  .cs-cols {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 5.952%;
    width: 100%;
  }

  .cs-col {
    display: flex;
    flex-direction: column;
    flex: none;
  }

  .cs-piece {
    position: relative;
  }

  .cs-piece img {
    width: 100%;
    height: auto;
  }

  .cs-piece .cs-piece__over {
    position: absolute;
    height: auto;
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.18);
  }

  .cs-after {
    height: auto;
  }

  .cs-results {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 1.56vw, 30px);
    padding: clamp(80px, 6.25vw, 120px) var(--gutter);
    background: var(--ink);
    color: var(--paper);
  }

  .cs-results__title {
    font-weight: 400;
    font-size: clamp(52px, 6.25vw, 120px);
    line-height: 1;
    text-transform: uppercase;
  }

  .cs-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: clamp(16px, 1.56vw, 30px);
  }

  .cs-stat {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 28px;
    border-top: 1px solid rgb(255 255 255 / 0.3);
  }

  .cs-stat__value {
    width: fit-content;
    font-weight: 600;
    font-size: clamp(64px, 8.33vw, 160px);
    line-height: 1;
    letter-spacing: 0.05em;
  }

  .cs-sum {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 1120px);
    justify-content: space-between;
    gap: 40px 60px;
    margin-top: clamp(40px, 5.2vw, 100px);
  }

  .cs-sum__list {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .cs-sum__list ul {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .cs-sum__list li {
    position: relative;
    padding-left: 30px;
    font-weight: 600;
    line-height: 1.6;
  }

  .cs-sum__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 8px;
    background: var(--sun);
  }

  .cs-quote {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: clamp(64px, 5.2vw, 100px) var(--gutter-wide);
    background: var(--sun);
  }

  .cs-quote__mark {
    font-weight: 600;
    font-size: clamp(100px, 8.33vw, 160px);
    line-height: 0.6;
    height: 0.4em;
  }

  .cs-quote blockquote {
    max-width: 1300px;
    font-size: var(--fs-quote);
    line-height: 1.45;
  }

  .cs-quote figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    font-size: 14px;
  }

  .cs-quote__rule {
    width: 24px;
    height: 1px;
    background: currentColor;
    opacity: 0.4;
  }

  @media (max-width: 899px) {
    .cs-meta {
      grid-template-columns: 1fr 1fr;
    }

    .cs-row,
    .cs-bullet,
    .cs-sum {
      grid-template-columns: 1fr;
    }

    .cs-stats {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .cs-gallery {
      --gutter-gal: 16px;
    }

    .cs-cols {
      gap: 3%;
    }
  }
</style>
