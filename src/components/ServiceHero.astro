---
import Button from './Button.astro';

// Service hero ('Hero / Service' in Figma), built like the home Spotlight:
// flowing sun, clouds, a picture in the middle and the title blended over
// it. The small ticking 'xt - 2sm' mark in the corner carries the scroll
// transition: it grows to the middle, its flat arm floods the screen in the
// next section's colour and the other two arms fly off (main.ts).
// The AI page swaps the picture for the interactive glass cubes.
interface Props {
  hero: any;
  clouds?: string;
}
const { hero, clouds = '/images/clouds.webp' } = Astro.props;
const stops = hero.sun.map((s: any) => `${s.color} ${Math.round(s.at * 100)}%`).join(', ');
const tone = hero.tone ?? 'dark';
const art = hero.art;
---
<section
  class:list={['sh', `sh--${tone}`]}
  style={`--sh-bg:${hero.background};--sh-sun:radial-gradient(circle at 23.9% 88.2%, ${stops})`}
  aria-labelledby="sh-title"
  data-sh
>
  <div class="sh__pin">
    <div class="sh__sky" data-sh-sky aria-hidden="true">
      <img class="sh__cloud sh__cloud--2" src={clouds} alt="" width="2000" height="1122" />
      <img class="sh__cloud sh__cloud--1" src={clouds} alt="" width="2000" height="1122" />
      <img class="sh__cloud sh__cloud--3" src={clouds} alt="" width="2000" height="1122" />
      <span class="sh__sun"><span class="sh__sun-flow"></span></span>
    </div>

    {art && (
      <div class:list={['sh__stage sh__stage--art', art.blend && `sh__blend--${art.blend}`]} data-stage data-sh-art>
        <img
          class="sh__art"
          src={art.src}
          alt={art.alt ?? ''}
          width={art.w}
          height={art.h}
          style={`left:${art.x}px;top:${art.y}px;width:${art.w}px${art.rotate ? `;rotate:${-art.rotate}deg` : ''}`}
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}
    {hero.cubes && <canvas class="sh__gl" data-cubes-gl data-sh-art aria-hidden="true"></canvas>}

    <!-- The title gets its own stage so its exclusion blend reaches the art -->
    <div class="sh__stage sh__stage--title" data-stage data-sh-title>
      <h1 id="sh-title" class:list={['sh__title', `sh__title--${hero.titleSize ?? 'l'}`]}>{hero.title}</h1>
    </div>
    <div class="sh__stage sh__stage--copy" data-stage data-sh-copy>
      <span class="sh__xt-anchor" data-sh-anchor></span>
      <p class:list={['sh__overline mono', `sh__overline--${hero.overlineColor ?? 'yellow'}`]}>{hero.overline}</p>
      {hero.card ? (
        <div class="sh__card">
          <p class="sh__card-title">{hero.card.title}</p>
          <p>{hero.card.text}</p>
          <Button href={hero.card.button.href} label={hero.card.button.label} />
        </div>
      ) : (
        <p class="sh__text">{hero.text}</p>
      )}
    </div>
    {hero.hint && <p class="sh__hint mono" aria-hidden="true">{hero.hint}</p>}

    <!-- 'xt - 2sm': flat arm, gradient arm and the ticking yellow hand -->
    <div class="sh__xt" aria-hidden="true">
      <span class="sh__arm sh__arm--x" data-sh-x></span>
      <span class="sh__arm sh__arm--y" data-sh-y></span>
      <span class="sh__arm sh__arm--hand" data-sh-hand></span>
    </div>
  </div>
</section>

<style>
  .sh {
    --flood: var(--paper);
    position: relative;
    /* The pin holds the hero while the mark plays the transition */
    height: 250svh;
    background: var(--flood);
    color: var(--paper);
  }

  .sh--light {
    color: var(--ink);
  }

  .sh__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: var(--sh-bg);
    isolation: isolate;
  }

  .sh__sky,
  .sh__gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sh__sky {
    overflow: hidden;
    pointer-events: none;
  }

  /* Scroll parallax, set by main.ts: each layer lifts at its own speed */
  .sh__sky {
    translate: 0 var(--sy, 0px);
  }

  .sh__stage--art,
  .sh__gl {
    translate: 0 var(--ay, 0px);
  }

  .sh__stage--title {
    translate: 0 var(--ty, 0px);
  }

  .sh__stage--copy {
    translate: 0 var(--cy, 0px);
  }

  .sh__gl {
    touch-action: pan-y;
  }

  .sh__pin.is-dragging .sh__gl {
    cursor: grabbing;
  }

  /* The sun's gradient flows: an oversized gradient layer turns slowly and
     drifts inside the round mask, all on the compositor */
  .sh__sun {
    position: absolute;
    left: 50%;
    top: 0;
    width: min(800px, 74svh);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    translate: -50% -50%;
  }

  .sh__sun-flow {
    position: absolute;
    inset: -25%;
    background: var(--sh-sun);
    animation: sh-flow 26s ease-in-out infinite alternate;
  }

  @keyframes sh-flow {
    0% {
      transform: rotate(-14deg) translate(-4%, 3%) scale(1);
    }
    50% {
      transform: rotate(10deg) translate(5%, -4%) scale(1.08);
    }
    100% {
      transform: rotate(-6deg) translate(-3%, -6%) scale(1.03);
    }
  }

  .sh__cloud {
    position: absolute;
    max-width: none;
    height: auto;
    animation: sh-drift 14s ease-in-out infinite alternate;
  }

  .sh__cloud--1 {
    animation-duration: 18s;
    animation-delay: -6s;
  }

  .sh__cloud--3 {
    animation-duration: 11s;
    animation-delay: -3s;
  }

  @keyframes sh-drift {
    to {
      translate: 28px 0;
    }
  }

  .sh__cloud--2 {
    left: calc(50% - 1367px);
    bottom: -574px;
    width: 2111px;
    opacity: 0.5;
    transform: scaleX(-1);
  }

  .sh__cloud--1 {
    left: calc(50% - 988px);
    bottom: -542px;
    width: 2443px;
  }

  .sh__cloud--3 {
    left: calc(50% - 1010px);
    bottom: -656px;
    width: 1623px;
  }

  /* 1920 x 1080 artboard, scaled to the screen by main.ts like the spotlight */
  .sh__stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--stage-w, 1920px);
    height: var(--stage-h, 1080px);
    transform: translate(-50%, -50%) scale(var(--stage-scale, 1));
    pointer-events: none;
  }

  /* The art keeps its place on the 1920 artboard, centred on wider stages */
  .sh__art {
    position: absolute;
    max-width: none;
    height: auto;
    margin-left: calc(50% - 960px);
    /* Figma turns layers about their top left corner */
    transform-origin: 0 0;
    animation: sh-rise 1.6s var(--ease-out) 0.1s both;
  }

  @keyframes sh-rise {
    from {
      opacity: 0;
      translate: 0 80px;
    }
  }

  .sh__blend--exclusion {
    mix-blend-mode: exclusion;
  }

  .sh__blend--luminosity {
    mix-blend-mode: luminosity;
  }

  .sh__stage--title {
    mix-blend-mode: exclusion;
  }

  /* Only the card takes clicks; everything else lets the cubes be dragged
     right through the title and copy */
  .sh__card {
    pointer-events: auto;
  }

  .sh__xt-anchor {
    position: absolute;
    left: max(66px, calc(50% - 1194px));
    top: 189px;
    width: 100px;
    height: 100px;
  }

  .sh__overline {
    position: absolute;
    left: max(45px, calc(50% - 1180px));
    top: 479px;
  }

  .sh__overline--yellow {
    color: var(--sun);
  }

  .sh__overline--ink {
    color: var(--ink);
  }

  .sh__title {
    position: absolute;
    left: max(36px, calc(50% - 1200px));
    top: 520px;
    font-weight: 400;
    font-size: 235px;
    line-height: 0.75;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--paper);
    animation: sh-in 1.4s var(--ease-out) 0.15s both;
  }

  .sh__title--m {
    font-size: 200px;
    top: 540px;
  }

  @keyframes sh-in {
    from {
      opacity: 0;
      translate: 0 60px;
    }
  }

  .sh__text {
    position: absolute;
    right: max(45px, calc(50% - 1200px));
    top: 834px;
    width: 449px;
    font-size: 20px;
    line-height: 2;
    /* Black on every hero, as in Figma: it sits over the clouds */
    color: var(--ink);
    animation: sh-in 1.4s var(--ease-out) 0.5s both;
  }

  .sh__card {
    position: absolute;
    right: max(45px, calc(50% - 1200px));
    top: 616px;
    width: 515px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding: 36px 20px 30px;
    border-radius: 20px;
    background: var(--paper);
    color: var(--ink);
    font-size: 20px;
    line-height: 2;
    animation: sh-in 1.4s var(--ease-out) 0.5s both;
  }

  .sh__card-title {
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .sh__card :global(.btn) {
    padding: 18px 30px 18px 34px;
  }

  .sh__hint {
    position: absolute;
    left: 50%;
    bottom: 24px;
    translate: -50% 0;
    z-index: 2;
    font-size: 11px;
    color: var(--paper);
    mix-blend-mode: difference;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.6s;
  }

  .sh__pin.is-touched .sh__hint,
  :global(.no-webgl) .sh__hint {
    opacity: 0;
  }

  /* The mark: three bars around one centre. main.ts sizes and moves them
     in screen pixels from the anchor's box; until then they sit on it. */
  .sh__xt {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    pointer-events: none;
  }

  .sh__arm {
    position: absolute;
    left: 0;
    top: 0;
    width: 100px;
    height: 100px;
    transform-origin: 0 0;
    will-change: transform;
    visibility: hidden;
  }

  .sh.is-ready .sh__arm {
    visibility: visible;
  }

  .sh__arm--x {
    /* Paper on dark heroes, ink on light ones, turning to the flood colour */
    --arm: var(--paper);
    background: color-mix(in srgb, var(--flood) calc(var(--fill, 0) * 100%), var(--arm));
  }

  .sh--light .sh__arm--x {
    --arm: var(--ink);
  }

  .sh__arm--y {
    background:
      linear-gradient(rgb(255 0 170 / 0.5), rgb(57 0 126 / 0.5) 50%, rgb(0 205 228 / 0.5)),
      #00cde4;
  }

  .sh__arm--hand {
    background: var(--sun);
  }

  @media (prefers-reduced-motion: reduce) {
    .sh__sun-flow,
    .sh__cloud,
    .sh__art {
      animation: none;
    }

    .sh {
      height: auto;
    }
  }

  @media (max-width: 899px) {
    .sh {
      height: 220svh;
    }

    /* Phones: no artboard scaling, the copy stacks at the bottom */
    .sh__pin {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 18px;
      padding: calc(var(--header-h) + 80px) var(--gutter) 40px;
    }

    .sh__stage--title,
    .sh__stage--copy {
      display: contents;
    }

    /* main.ts scales the art's artboard to the phone's width */
    .sh__stage--art {
      top: calc(50% + 4svh);
      /* Photos run past the artboard's foot: fade them out above the copy */
      mask: linear-gradient(#000 940px, transparent 1080px) 0 0 / 100% 1080px no-repeat;
    }

    .sh__xt-anchor {
      left: var(--gutter);
      top: calc(var(--header-h) + 28px);
      width: 52px;
      height: 52px;
    }

    .sh__overline,
    .sh__title,
    .sh__text,
    .sh__card {
      position: relative;
      inset: auto;
      width: auto;
    }

    .sh__overline {
      order: 1;
    }

    .sh__title {
      transform: translateY(var(--ty, 0px));
    }

    .sh__overline,
    .sh__text,
    .sh__card {
      transform: translateY(var(--cy, 0px));
    }

    .sh__title,
    .sh__title--m {
      order: 2;
      font-size: clamp(48px, 15vw, 120px);
      white-space: normal;
      line-height: 0.85;
      mix-blend-mode: exclusion;
    }

    .sh__text,
    .sh__card {
      order: 3;
      font-size: 15px;
      line-height: 1.8;
    }

    .sh__card {
      padding: 24px;
      gap: 16px;
    }

    /* The clouds sit right behind the copy here, so give it a soft panel */
    .sh__text {
      padding: 18px 20px;
      border-radius: 16px;
      background: rgb(255 255 255 / 0.82);
      backdrop-filter: blur(8px);
    }

    .sh__sun {
      width: 90vw;
    }

    .sh__hint {
      top: calc(var(--header-h) + 8px);
      bottom: auto;
    }
  }
</style>
