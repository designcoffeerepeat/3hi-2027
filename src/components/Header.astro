---
import Logo from './Logo.astro';
import ScanBar from './ScanBar.astro';
import Icon from './Icon.astro';
import { getServices } from '../lib/content';

interface Props {
  site: any;
}
const { site } = Astro.props;
const h = site.header;
const d = h.dropdown;
const services = (await getServices()).map((s) => ({ ...(s.data as any), href: `/services/${s.id}` }));
const here = Astro.url.pathname.replace(/\/$/, '');
---
<header class="header" data-header>
  <a class="header__logo" href="/" aria-label={`${site.brand} home`}>
    <Logo />
  </a>
  <div class="header__nav">
    <ScanBar class="header__scan" variant="dark" id="scan-header" placeholder={h.scanPlaceholder} button={h.scanButton} />
    <div class="header__right">
      <nav class="header__links label" aria-label="Quick links">
        {h.quickLinks.map((l: any) =>
          l.href === '/services' && d ? (
            <button class="header__drop" type="button" aria-expanded="false" aria-controls="nav-drop" data-drop-open>
              {l.label}
              <svg viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.6" /></svg>
            </button>
          ) : (
            <a href={l.href}>{l.label}</a>
          ),
        )}
      </nav>
      <button class="header__burger" type="button" aria-label={h.menuLabel} aria-expanded="false" aria-controls="site-menu" data-menu-open>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  {d && (
    <div class="drop" id="nav-drop" hidden data-drop>
      <div class="drop__main">
        <p class="drop__overline mono">{d.overline}</p>
        <ul class="drop__list">
          {services.map((sv: any) => (
            <li>
              <a class:list={['drop__item', { 'is-current': here === sv.href }]} href={sv.href}>
                <span class="drop__num mono">{sv.number}</span>
                <span class="drop__txt">
                  <span class="drop__title">{sv.name}</span>
                  <span class="drop__desc">{sv.menuText}</span>
                </span>
                <Icon name="arrow" class="drop__arrow" />
              </a>
            </li>
          ))}
        </ul>
        <a class="drop__all label" href={d.allHref}>{d.allLabel} <Icon name="arrow" size={16} /></a>
      </div>
      <div class="drop__feature">
        <p class="mono">{d.feature.overline}</p>
        <p class="drop__feature-title">{d.feature.title}</p>
        <p class="drop__feature-text">{d.feature.text}</p>
        <button class="drop__feature-btn label" type="button" data-drop-scan>{d.feature.button} <Icon name="scan" /></button>
      </div>
    </div>
  )}
</header>
<div class="drop-scrim" data-drop-scrim aria-hidden="true"></div>

<style>
  .header {
    --pill-h: clamp(64px, 5.21vw, 100px);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(16px, 2.6vw, 50px) var(--edge) 0;
    pointer-events: none;
    transition: padding 0.6s var(--ease-out);
  }

  .header > * {
    pointer-events: auto;
    transition: scale 0.6s var(--ease-out);
  }

  .header__logo {
    transform-origin: left center;
  }

  .header__nav {
    transform-origin: right center;
  }

  /* Scrolled: everything shrinks to half size */
  .header.is-compact {
    padding-top: clamp(8px, 0.8vw, 16px);
    padding-inline: max(clamp(8px, 0.8vw, 16px), calc((100vw - var(--frame)) / 2));
  }

  .header.is-compact > * {
    scale: 0.65;
  }

  .header__logo {
    display: grid;
    place-items: center;
    flex: none;
    height: var(--pill-h);
    width: calc(var(--pill-h) * 2.17);
    background: var(--ink);
    border-radius: 300px;
  }

  .header__logo :global(.logo) {
    width: 65.4%;
  }

  .header__nav {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--pill-h);
    width: min(1204px, 62.7vw);
    padding: 0 calc(var(--pill-h) * 0.15);
    background: var(--sun-nav);
    border-radius: 300px;
    transition:
      width 0.8s var(--ease-out),
      padding 0.8s var(--ease-out),
      gap 0.8s var(--ease-out);
  }

  .header__nav :global(.header__scan) {
    --scan-pad: calc(var(--pill-h) * 0.08);
    flex: 0 1 671px;
    min-width: 0;
    height: calc(var(--pill-h) * 0.7);
    transition:
      opacity 0.35s,
      translate 0.5s var(--ease-out),
      visibility 0.35s;
  }

  /* While the AI scan section is on screen the header scan bar steps
     aside and the yellow pill closes up around the links and menu. */
  .header.is-scan-away .header__nav {
    /* Extra room on the left so Services does not hug the pill's edge */
    width: calc(var(--nav-short, 0px) + var(--pill-h) * 0.25);
    padding-left: calc(var(--pill-h) * 0.4);
    gap: 0;
    transition-delay: 0.12s;
  }

  .header.is-scan-away .header__nav :global(.header__scan) {
    /* Out of the flow so it takes no room while the pill closes up */
    position: absolute;
    left: calc(var(--pill-h) * 0.15);
    width: 671px;
    opacity: 0;
    translate: -40px 0;
    visibility: hidden;
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: 50px;
    flex: none;
  }

  .header__links {
    display: flex;
    gap: 20px;
  }

  .header__links a {
    position: relative;
  }

  .header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }

  .header__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Three square ended bars: white, yellow, white. When the menu opens
     they turn into the 'xt - 1' close mark, centred on the same spot as the
     menu's own: top bar to the white x arm, bottom bar to the cyan y arm and
     the yellow middle bar to the second hand. */
  .header__burger {
    --size: calc(var(--pill-h) * 0.7);
    --bar-w: calc(var(--size) - 30px);
    /* The 'x' stays inside the circle with room around it */
    --arm: calc(var(--size) * 0.6);
    --stroke: calc(var(--arm) * 50 / 661);
    position: relative;
    display: block;
    width: var(--size);
    height: var(--size);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    cursor: pointer;
  }

  .header__burger span {
    --y: 0px;
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--bar-w);
    height: 3px;
    background: var(--paper);
    translate: -50% calc(-50% + var(--y));
    transition:
      width 0.45s var(--ease-out),
      height 0.45s var(--ease-out),
      translate 0.45s var(--ease-out),
      rotate 0.45s var(--ease-out),
      background-color 0.3s;
  }

  .header__burger span:nth-child(1) {
    --y: -10px;
    z-index: 1;
  }

  .header__burger span:nth-child(2) {
    z-index: 3;
    background: var(--sun);
  }

  .header__burger span:nth-child(3) {
    --y: 10px;
    z-index: 2;
  }

  /* y arm gradient, faded in as the bottom bar turns upright */
  .header__burger span:nth-child(3)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #8066c7, #1c66b1 50%, #00cde4);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .header__burger:not([aria-expanded='true']):hover span:nth-child(1) {
    translate: calc(-50% - 4px) calc(-50% + var(--y));
  }

  .header__burger:not([aria-expanded='true']):hover span:nth-child(3) {
    translate: calc(-50% + 4px) calc(-50% + var(--y));
  }

  .header__burger[aria-expanded='true'] span {
    --y: 0px;
    width: var(--arm);
    height: var(--stroke);
  }

  .header__burger[aria-expanded='true'] span:nth-child(2) {
    rotate: -45deg;
  }

  .header__burger[aria-expanded='true'] span:nth-child(3) {
    rotate: 90deg;
  }

  .header__burger[aria-expanded='true'] span:nth-child(3)::after {
    opacity: 1;
  }

  /* Services dropdown */
  .header__drop {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .header__drop svg {
    width: 10px;
    transition: rotate 0.4s var(--ease-out);
  }

  .header__drop[aria-expanded='true'] svg {
    rotate: 180deg;
  }

  .drop {
    position: absolute;
    top: calc(100% + 14px);
    right: var(--edge);
    display: flex;
    gap: 20px;
    width: min(1204px, calc(100vw - 2 * var(--edge)));
    max-height: calc(100svh - 100% - 40px);
    overflow: auto;
    padding: 20px;
    border-radius: 30px;
    background: var(--ink);
    color: var(--paper);
    opacity: 0;
    translate: 0 -12px;
    transition:
      opacity 0.35s var(--ease-out),
      translate 0.5s var(--ease-out);
  }

  .drop[hidden] {
    display: none;
  }

  .header.is-compact > .drop {
    scale: 1;
    top: calc(100% - 20px);
  }

  .drop.is-open {
    opacity: 1;
    translate: 0 0;
  }

  .drop__main {
    flex: 1;
    min-width: 0;
    padding: 20px 20px 10px;
  }

  .drop__overline {
    color: var(--sun);
    margin-bottom: 20px;
  }

  .drop__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 12px;
  }

  .drop__item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 20px;
    border-radius: 18px;
    transition: background-color 0.3s;
  }

  .drop__item:hover,
  .drop__item:focus-visible,
  .drop__item.is-current {
    background: rgb(255 255 255 / 0.1);
  }

  .drop__num {
    align-self: flex-start;
    padding-top: 8px;
    color: var(--sun);
  }

  .drop__txt {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .drop__title {
    font-weight: 600;
    font-size: clamp(18px, 1.354vw, 26px);
    line-height: 1.3;
  }

  .drop__desc {
    font-size: 16px;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.7);
  }

  .drop__item :global(.drop__arrow) {
    flex: none;
    transition: rotate 0.4s var(--ease-out);
  }

  .drop__item:hover :global(.drop__arrow) {
    rotate: 45deg;
  }

  .drop__all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 24px 20px 6px;
    color: var(--sun);
  }

  .drop__feature {
    flex: 0 0 384px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: 40px;
    border-radius: 20px;
    background: var(--sun);
    color: var(--ink);
  }

  .drop__feature-title {
    font-weight: 600;
    font-size: clamp(28px, 2.08vw, 40px);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .drop__feature-text {
    font-size: 16px;
    line-height: 1.7;
  }

  .drop__feature-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding: 18px 28px;
    border: 0;
    border-radius: 300px;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .drop__feature-btn:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .drop-scrim {
    position: fixed;
    inset: 0;
    z-index: 49;
    background: rgb(0 0 0 / 0.35);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s,
      visibility 0.4s;
  }

  .drop-scrim.is-on {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 1100px) {
    .drop__feature {
      display: none;
    }
  }

  @media (max-width: 1279px) {
    .header__nav :global(.header__scan) {
      display: none;
    }

    .header__nav {
      width: auto;
      padding-left: 32px;
    }
  }

  @media (max-width: 767px) {
    /* Phones have no scan bar or pill here, so the AI scan section must not
       close the nav up: that clipped the hamburger into a lemon shape */
    .header__nav,
    .header.is-scan-away .header__nav {
      width: auto;
      background: none;
      padding: 0;
    }

    .header__links {
      display: none;
    }

    .header__burger {
      --size: var(--pill-h);
      --bar-w: calc(var(--size) - 36px);
    }

    /* Phones keep the header at full size when scrolled: shrinking it
       squashed the hamburger */
    .header.is-compact {
      padding: clamp(16px, 2.6vw, 50px) var(--edge) 0;
    }

    .header.is-compact > * {
      scale: none;
    }
  }
</style>
