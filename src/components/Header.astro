---
import Logo from './Logo.astro';
import ScanBar from './ScanBar.astro';

interface Props {
  site: any;
}
const { site } = Astro.props;
const h = site.header;
---
<header class="header" data-header>
  <a class="header__logo" href="/" aria-label={`${site.brand} home`}>
    <Logo />
  </a>
  <div class="header__nav">
    <ScanBar class="header__scan" variant="dark" id="scan-header" placeholder={h.scanPlaceholder} button={h.scanButton} />
    <div class="header__right">
      <nav class="header__links label" aria-label="Quick links">
        {h.quickLinks.map((l: any) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <button class="header__burger" type="button" aria-label={h.menuLabel} aria-expanded="false" aria-controls="site-menu" data-menu-open>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    --pill-h: clamp(64px, 5.21vw, 100px);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(16px, 2.6vw, 50px) var(--edge) 0;
    pointer-events: none;
    transition: padding 0.6s var(--ease-out);
  }

  .header > * {
    pointer-events: auto;
    transition: scale 0.6s var(--ease-out);
  }

  .header__logo {
    transform-origin: left center;
  }

  .header__nav {
    transform-origin: right center;
  }

  /* Scrolled: everything shrinks to half size */
  .header.is-compact {
    padding-top: clamp(8px, 0.8vw, 16px);
    padding-inline: max(clamp(8px, 0.8vw, 16px), calc((100vw - var(--frame)) / 2));
  }

  .header.is-compact > * {
    scale: 0.65;
  }

  .header__logo {
    display: grid;
    place-items: center;
    flex: none;
    height: var(--pill-h);
    width: calc(var(--pill-h) * 2.17);
    background: var(--ink);
    border-radius: 300px;
  }

  .header__logo :global(.logo) {
    width: 65.4%;
  }

  .header__nav {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--pill-h);
    width: min(1204px, 62.7vw);
    padding: 0 calc(var(--pill-h) * 0.15);
    background: var(--sun-nav);
    border-radius: 300px;
    transition:
      width 0.8s var(--ease-out),
      padding 0.8s var(--ease-out),
      gap 0.8s var(--ease-out);
  }

  .header__nav :global(.header__scan) {
    --scan-pad: calc(var(--pill-h) * 0.08);
    flex: 0 1 671px;
    min-width: 0;
    height: calc(var(--pill-h) * 0.7);
    transition:
      opacity 0.35s,
      translate 0.5s var(--ease-out),
      visibility 0.35s;
  }

  /* While the AI scan section is on screen the header scan bar steps
     aside and the yellow pill closes up around the links and menu. */
  .header.is-scan-away .header__nav {
    /* Extra room on the left so Services does not hug the pill's edge */
    width: calc(var(--nav-short, 0px) + var(--pill-h) * 0.25);
    padding-left: calc(var(--pill-h) * 0.4);
    gap: 0;
    transition-delay: 0.12s;
  }

  .header.is-scan-away .header__nav :global(.header__scan) {
    /* Out of the flow so it takes no room while the pill closes up */
    position: absolute;
    left: calc(var(--pill-h) * 0.15);
    width: 671px;
    opacity: 0;
    translate: -40px 0;
    visibility: hidden;
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: 50px;
    flex: none;
  }

  .header__links {
    display: flex;
    gap: 20px;
  }

  .header__links a {
    position: relative;
  }

  .header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }

  .header__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Three square ended bars: white, yellow, white. When the menu opens
     they turn into the 'xt - 1' close mark, centred on the same spot as the
     menu's own: top bar to the white x arm, bottom bar to the cyan y arm and
     the yellow middle bar to the second hand. */
  .header__burger {
    --size: calc(var(--pill-h) * 0.7);
    --bar-w: calc(var(--size) - 30px);
    /* The 'x' stays inside the circle with room around it */
    --arm: calc(var(--size) * 0.6);
    --stroke: calc(var(--arm) * 50 / 661);
    position: relative;
    display: block;
    width: var(--size);
    height: var(--size);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    cursor: pointer;
  }

  .header__burger span {
    --y: 0px;
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--bar-w);
    height: 3px;
    background: var(--paper);
    translate: -50% calc(-50% + var(--y));
    transition:
      width 0.45s var(--ease-out),
      height 0.45s var(--ease-out),
      translate 0.45s var(--ease-out),
      rotate 0.45s var(--ease-out),
      background-color 0.3s;
  }

  .header__burger span:nth-child(1) {
    --y: -10px;
    z-index: 1;
  }

  .header__burger span:nth-child(2) {
    z-index: 3;
    background: var(--sun);
  }

  .header__burger span:nth-child(3) {
    --y: 10px;
    z-index: 2;
  }

  /* y arm gradient, faded in as the bottom bar turns upright */
  .header__burger span:nth-child(3)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #8066c7, #1c66b1 50%, #00cde4);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .header__burger:not([aria-expanded='true']):hover span:nth-child(1) {
    translate: calc(-50% - 4px) calc(-50% + var(--y));
  }

  .header__burger:not([aria-expanded='true']):hover span:nth-child(3) {
    translate: calc(-50% + 4px) calc(-50% + var(--y));
  }

  .header__burger[aria-expanded='true'] span {
    --y: 0px;
    width: var(--arm);
    height: var(--stroke);
  }

  .header__burger[aria-expanded='true'] span:nth-child(2) {
    rotate: -45deg;
  }

  .header__burger[aria-expanded='true'] span:nth-child(3) {
    rotate: 90deg;
  }

  .header__burger[aria-expanded='true'] span:nth-child(3)::after {
    opacity: 1;
  }

  @media (max-width: 1279px) {
    .header__nav :global(.header__scan) {
      display: none;
    }

    .header__nav {
      width: auto;
      padding-left: 32px;
    }
  }

  @media (max-width: 767px) {
    .header__nav {
      background: none;
      padding: 0;
    }

    .header__links {
      display: none;
    }

    .header__burger {
      --size: var(--pill-h);
      --bar-w: calc(var(--size) - 36px);
    }

    /* Keep a comfortable tap target on phones */
    .header.is-compact > * {
      scale: 0.8;
    }
  }
</style>
