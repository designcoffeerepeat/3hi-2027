---
import Icon from './Icon.astro';

// Pill button. Dark is the primary CTA, Yellow for dark sections, Light for image overlays.
// Without href it renders as a span, for use inside a larger link.
interface Props {
  href?: string;
  label: string;
  variant?: 'dark' | 'yellow' | 'light';
  class?: string;
}
const { href, label, variant = 'dark', class: className } = Astro.props;
---
{href ? (
  <a href={href} class:list={['btn', `btn--${variant}`, className]}>
    <span class="label">{label}</span>
    <Icon name="arrow" class="btn__icon" />
  </a>
) : (
  <span class:list={['btn', `btn--${variant}`, className]}>
    <span class="label">{label}</span>
    <Icon name="arrow" class="btn__icon" />
  </span>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 26px 40px 26px 48px;
    border-radius: 300px;
    white-space: nowrap;
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.4s var(--ease-out);
  }

  .btn--dark {
    background: var(--ink);
    color: var(--paper);
  }

  .btn--yellow {
    background: var(--sun);
    color: var(--ink);
  }

  .btn--light {
    background: var(--paper);
    color: var(--ink);
  }

  .btn :global(.btn__icon) {
    transition: transform 0.4s var(--ease-out);
  }

  .btn:hover :global(.btn__icon) {
    transform: rotate(45deg);
  }

  .btn--dark:hover {
    background: var(--sun);
    color: var(--ink);
  }

  .btn--yellow:hover {
    background: var(--paper);
  }

  @media (max-width: 767px) {
    .btn {
      padding: 20px 28px 20px 32px;
    }
  }
</style>
