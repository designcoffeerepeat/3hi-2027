---
import Overline from './Overline.astro';

interface Props {
  method: any;
}
const { method } = Astro.props;
---
<section class="section method" aria-labelledby="method-title">
  <div class="method__head">
    <Overline text={method.overline} tone="paper" />
    <h2 id="method-title" class="display-xl" data-reveal data-speed="0.05">{method.title}</h2>
  </div>
  <ol class="method__steps">
    {method.steps.map((s: any, i: number) => (
      <li class="step" data-reveal style={`--reveal-delay:${i * 110}ms`}>
        <p class="step__num grad-text" data-speed={`${0.04 + i * 0.02}`}>{s.number}</p>
        <h3 class="step__title">{s.title}</h3>
        <p class="step__text">{s.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .method {
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 5.2vw, 100px);
    padding: clamp(96px, 8.3vw, 160px) var(--gutter);
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
  }

  .method__head {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .method__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--paper);
  }

  .step__num {
    width: fit-content;
    font-weight: 600;
    font-size: clamp(72px, 6.25vw, 120px);
    line-height: 0.95;
    letter-spacing: 0.05em;
  }

  .step__title {
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  .step__text {
    font-size: var(--fs-body-m);
    line-height: 1.8;
  }

  @media (max-width: 1100px) {
    .method__steps {
      grid-template-columns: 1fr 1fr;
      row-gap: 56px;
    }
  }

  @media (max-width: 599px) {
    .method__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
