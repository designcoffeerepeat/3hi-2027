---
import Overline from './Overline.astro';

interface Props {
  intro: any;
}
const { intro } = Astro.props;
// The big line lights up word by word on scroll; older copy has only text.
const words = (intro.title ?? intro.text).split(' ');
---
<section class="section intro" aria-label={intro.overline}>
  <div class="intro__top">
    <Overline text={intro.overline} />
    <div class="intro__copy">
      <p class="intro__text" data-scrub-words>
        {words.map((w: string) => <span>{w} </span>)}
      </p>
      {intro.title && <p class="intro__sub" data-reveal>{intro.text}</p>}
    </div>
  </div>
  <div class="intro__stats">
    {intro.stats.map((s: any, i: number) => (
      <div class="stat" data-reveal style={`--reveal-delay:${i * 100}ms`}>
        <p class="stat__value display-l" data-count={s.value}>{s.value}</p>
        <p class="stat__label mono">{s.label}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(64px, 6.25vw, 120px);
    padding: clamp(96px, 9.4vw, 180px) var(--gutter-wide) clamp(96px, 8.3vw, 160px);
  }

  .intro__top {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(32px, 6.25vw, 120px);
    align-items: start;
  }

  .intro__text {
    font-size: var(--fs-heading-xl);
    line-height: 1.2;
  }

  .intro__copy {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 2.6vw, 50px);
  }

  .intro__sub {
    max-width: 1100px;
    font-size: clamp(17px, 1.354vw, 26px);
    line-height: 1.7;
  }

  .js .intro__text span {
    opacity: 0.15;
    transition: opacity 0.4s;
  }

  .js .intro__text span.is-on {
    opacity: 1;
  }

  .intro__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }

  .stat__label {
    line-height: 1.2;
  }

  @media (max-width: 899px) {
    .intro__top {
      grid-template-columns: 1fr;
    }

    .intro__stats {
      grid-template-columns: 1fr 1fr;
      row-gap: 48px;
    }
  }

  @media (max-width: 479px) {
    .stat__label {
      font-size: 11px;
    }
  }
</style>
