---
import Logo from './Logo.astro';
import XtMark from './XtMark.astro';
import { getServices } from '../lib/content';

interface Props {
  site: any;
}
const { site } = Astro.props;
const m = site.menu;
const services = (await getServices()).map((s) => ({ name: (s.data as any).name, href: `/services/${s.id}` }));
---
<div class="menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden data-menu>
  <div class="menu__top">
    <a class="menu__logo" href="/" aria-label={`${site.brand} home`}><Logo /></a>
    <button class="menu__close" type="button" aria-label={site.header.closeLabel} data-menu-close>
      <XtMark />
    </button>
  </div>
  <nav class="menu__nav" aria-label="Main">
    <ul>
      {m.links.map((l: any, i: number) => (
        <li style={`--i:${i}`} class:list={{ 'menu__has-sub': l.submenu }}>
          <a href={l.href}>
            <span class="menu__num mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="menu__label">{l.label}</span>
          </a>
          {l.submenu && (
            <>
              <button class="menu__toggle" type="button" aria-expanded="false" aria-controls={`menu-sub-${i}`} aria-label={`Show ${l.label.toLowerCase()}`} data-menu-toggle>
                <span aria-hidden="true"></span>
              </button>
              <div class="menu__sub" id={`menu-sub-${i}`} data-menu-sub>
                <ul>
                  {services.map((sv) => <li><a href={sv.href}>{sv.name}</a></li>)}
                  <li><a class="menu__sub-all mono" href={l.href}>{l.allLabel ?? 'All'}</a></li>
                </ul>
              </div>
            </>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <div class="menu__foot mono">
    <a href={`mailto:${m.email}`}>{m.email}</a>
    <span>{m.studios}</span>
  </div>
</div>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    /* Exactly one browser window tall, so the email and studios stay in view */
    height: 100vh;
    height: 100dvh;
    padding: clamp(16px, 2.6vw, 50px) var(--edge);
    background: var(--ink);
    color: var(--paper);
    overflow-y: auto;
    overscroll-behavior: contain;
    clip-path: circle(0% at var(--ox, calc(100% - 80px)) var(--oy, 80px));
    transition: clip-path 0.9s var(--ease-out);
  }

  .menu[hidden] {
    display: none;
  }

  .menu.is-open {
    clip-path: circle(150% at var(--ox, calc(100% - 80px)) var(--oy, 80px));
  }

  .menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: clamp(64px, 5.21vw, 100px);
  }

  .menu__logo {
    display: block;
    width: clamp(120px, 9.2vw, 177px);
    padding-left: clamp(0px, 1.7vw, 33px);
  }

  .menu__close {
    width: clamp(64px, 5.21vw, 100px);
    height: clamp(64px, 5.21vw, 100px);
    padding: clamp(8px, 0.8vw, 14px);
    border: 0;
    background: none;
    color: var(--paper);
    cursor: pointer;
    transition: transform 0.6s var(--ease-out);
  }

  .menu__close :global(svg) {
    width: 100%;
    height: 100%;
  }

  .menu__close:hover {
    transform: rotate(90deg);
  }

  .menu__nav {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    padding: clamp(16px, 3svh, 48px) 0;
  }

  .menu__nav ul {
    width: 100%;
  }

  .menu__nav li {
    overflow: hidden;
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }

  .menu__nav li:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.15);
  }

  .menu__nav a {
    display: flex;
    align-items: baseline;
    gap: clamp(16px, 3vw, 60px);
    padding: 0.2em 0;
    font-weight: 600;
    font-size: clamp(28px, min(5.2vw, 5.4svh), 100px);
    line-height: 1.05;
    text-transform: uppercase;
    transform: translate3d(0, 110%, 0);
    transition:
      transform 0.9s var(--ease-out),
      color 0.3s;
    transition-delay: calc(0.15s + var(--i) * 0.05s), 0s;
  }

  .menu.is-open .menu__nav a {
    transform: none;
  }

  /* Services: a + toggle opens the list of service pages underneath */
  .menu__has-sub {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
  }

  .menu__toggle {
    position: relative;
    width: clamp(44px, 4vw, 72px);
    height: clamp(44px, 4vw, 72px);
    /* Just the plus sign: no ring or fill */
    border: 0;
    background: none;
    color: var(--sun);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.6s var(--ease-out) 0.4s,
      color 0.3s;
  }

  .menu.is-open .menu__toggle {
    opacity: 1;
  }

  .menu__toggle:hover {
    color: var(--paper);
  }

  .menu__toggle span,
  .menu__toggle span::after {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 40%;
    height: 2px;
    margin: -1px 0 0 -20%;
    background: currentColor;
    transition: rotate 0.4s var(--ease-out);
  }

  .menu__toggle span::after {
    content: '';
    left: 0;
    margin: 0;
    width: 100%;
    rotate: 90deg;
  }

  .menu__toggle[aria-expanded='true'] span::after {
    rotate: 0deg;
  }

  .menu__sub {
    grid-column: 1 / -1;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease-out);
  }

  /* The indent sits on the list, so the small 'All services' label lines
     up with the service links */
  .menu__sub > ul {
    min-height: 0;
    overflow: hidden;
    font-size: clamp(18px, min(2.4vw, 3svh), 40px);
    padding-left: calc(3ch + clamp(16px, 3vw, 60px));
  }

  .menu__toggle[aria-expanded='true'] + .menu__sub {
    grid-template-rows: 1fr;
  }

  .menu__nav .menu__sub li {
    border: 0;
  }

  .menu__nav .menu__sub a {
    padding: 0.35em 0;
    font-size: clamp(18px, min(2.4vw, 3svh), 40px);
    font-weight: 400;
    transform: none;
  }

  .menu__nav .menu__sub li:last-child a {
    padding-bottom: 0.9em;
  }

  .menu__nav .menu__sub a:hover {
    color: var(--sun);
  }

  .menu__nav .menu__sub-all {
    padding: 22px 0 !important;
    font-size: 13px !important;
    color: var(--sun);
  }

  .menu__num {
    flex: none;
    width: 3ch;
    font-weight: 400;
    color: var(--sun);
  }

  .menu__label {
    transition: transform 0.5s var(--ease-out);
  }

  .menu__nav a:hover .menu__label {
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform: translateX(0.15em);
  }

  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
  }

  .menu__foot a:hover {
    color: var(--sun);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu__nav a {
      transition: none;
    }
  }
</style>
