---
import Overline from './Overline.astro';

// FAQ accordion. Native <details>, so it works without JavaScript; main.ts
// animates the height when it can.
interface Props {
  overline?: string;
  title?: string;
  items: { question: string; answer: string }[];
}
const { overline = 'FAQ', title = 'Questions, answered', items } = Astro.props;
---
<section class="faq" aria-labelledby="faq-title">
  <Overline text={overline} />
  <h2 id="faq-title" class="faq__title" data-reveal>{title}</h2>
  <div class="faq__list">
    {items.map((f, i) => (
      <details class="faq__item" data-faq>
        <summary>
          <span class="mono">Q{String(i + 1).padStart(2, '0')}</span>
          <span class="faq__q">{f.question}</span>
          <span class="faq__icon" aria-hidden="true"></span>
        </summary>
        <div class="faq__a"><p>{f.answer}</p></div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: clamp(80px, 6.25vw, 120px) var(--gutter);
  }

  .faq__title {
    font-weight: 400;
    font-size: clamp(44px, 6.25vw, 120px);
    line-height: 1;
    text-transform: uppercase;
  }

  .faq__list {
    margin-top: 20px;
    border-bottom: 1px solid #e3e3e0;
  }

  .faq__item {
    border-top: 1px solid #e3e3e0;
  }

  .faq__item summary {
    display: grid;
    grid-template-columns: minmax(60px, 1fr) 5fr 40px;
    align-items: center;
    gap: 24px;
    padding: 30px 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
    transition: color 0.3s;
  }

  .faq__item summary:hover .faq__q {
    color: var(--ink-60);
  }

  .faq__icon {
    position: relative;
    justify-self: end;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    transition: background-color 0.3s;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 2px;
    background: var(--paper);
    translate: -50% -50%;
    transition: rotate 0.4s var(--ease-out);
  }

  .faq__icon::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__icon {
    background: var(--sun);
  }

  .faq__item[open] .faq__icon::before,
  .faq__item[open] .faq__icon::after {
    background: var(--ink);
  }

  .faq__item[open] .faq__icon::after {
    rotate: 0deg;
  }

  .faq__a {
    overflow: hidden;
  }

  .faq__a p {
    max-width: 900px;
    margin-left: calc((100% - 88px) / 6 + 24px);
    padding-bottom: 34px;
    color: var(--ink-60);
  }

  @media (max-width: 699px) {
    .faq__item summary {
      grid-template-columns: 1fr 40px;
    }

    .faq__item summary .mono {
      display: none;
    }

    .faq__a p {
      margin-left: 0;
    }
  }
</style>
