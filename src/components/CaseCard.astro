---
import Icon from './Icon.astro';
import { hideEstimates } from '../lib/content';

// Square case study card: image, services and client top right, result pill
// bottom left. Used on the home page, the Work page and service pages.
interface Props {
  card: any;
  delay?: number;
}
const { card, delay = 0 } = Astro.props;
const result = card.resultEstimate && hideEstimates ? '' : card.result;
---
<a
  class:list={['case', `case--${card.textColor ?? 'black'}`]}
  href={card.href}
  data-reveal
  data-tags={card.tags?.join(' ')}
  style={`--reveal-delay:${delay}ms`}
>
  <div class="case__media">
    <img class="case__img" src={card.image} alt={card.imageAlt} width="960" height="960" loading="lazy" decoding="async" data-speed="-0.08" />
  </div>
  <div class="case__txt">
    <p class="case__services">{card.services}</p>
    <h3 class="case__client">{card.client}</h3>
  </div>
  <p class="case__result label">
    {result}
    <Icon name="arrow" size={18} />
  </p>
</a>

<style>
  /* Always fills its grid cell. On very wide screens the height stops at
     the viewport and the image crops instead of the card shrinking, so a
     two up grid never opens a gap down the middle. */
  .case {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    max-height: 100svh;
    overflow: hidden;
    background: var(--mist);
    container-type: inline-size;
  }

  .case__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .case__img {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    max-width: none;
    object-fit: cover;
    transition: scale 1.2s var(--ease-out);
  }

  .case:hover .case__img {
    scale: 1.04;
  }

  .case__txt {
    position: absolute;
    top: clamp(20px, 2.9vw, 56px);
    right: clamp(20px, 2.9vw, 56px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(264px, 38%);
    transition:
      background-color 0.3s,
      padding 0.3s;
  }

  .case--white .case__txt {
    color: var(--paper);
  }

  .case__services {
    font-size: clamp(13px, 0.83vw, 16px);
    line-height: 1.8;
  }

  .case__client {
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: 1.1;
    text-transform: uppercase;
    /* Line breaks from the content stay. Words never split: main.ts shrinks
       the name until its longest word fits the caption width */
    white-space: pre-line;
    overflow-wrap: normal;
  }

  .case__result {
    position: absolute;
    left: clamp(20px, 2.9vw, 56px);
    bottom: clamp(20px, 2.9vw, 56px);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border-radius: 300px;
    background: var(--sun);
    color: var(--ink);
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .case__result :global(svg) {
    transition: transform 0.4s var(--ease-out);
  }

  .case:hover .case__result {
    background: var(--ink);
    color: var(--sun);
  }

  .case:hover .case__result :global(svg) {
    transform: rotate(45deg);
  }

  /* Smaller cards: the caption would reach the people in the photo, so it
     shrinks and sits on its own panel */
  @container (max-width: 760px) {
    .case__txt {
      top: 14px;
      right: 14px;
      width: auto;
      /* Never wider than the Chimi caption, so it stays clear of faces */
      max-width: min(52%, 145px);
      gap: 4px;
      padding: 12px 14px;
      border-radius: 12px;
      background: rgb(255 255 255 / 0.82);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .case--white .case__txt {
      background: rgb(0 0 0 / 0.55);
    }

    .case__services {
      font-size: 11px;
      line-height: 1.5;
    }

    /* Sized so the longest single word (Pepperidge) fits the capped
       panel without breaking mid word */
    .case__client {
      font-size: clamp(15px, 4.2cqi, 19px);
      overflow-wrap: normal;
    }
  }

  @media (max-width: 899px) {
    .case__result {
      font-size: 12px;
      padding: 12px 18px;
    }
  }
</style>
