---
import Overline from './Overline.astro';

interface Props {
  clients: any;
}
const { clients } = Astro.props;
---
<section class="section clients" aria-label={clients.overline}>
  <Overline text={clients.overline} class="clients__overline" />
  <div class="clients__marquee" data-marquee>
    {[0, 1].map((copy) => (
      <ul class="clients__list" aria-hidden={copy === 1 ? 'true' : undefined}>
        {clients.names.map((name: string) => (
          <li><span class="clients__name">{name}</span><span class="clients__plus" aria-hidden="true">+</span></li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .clients {
    /* A short band, not a full screen; grows if the content needs it */
    min-height: clamp(320px, 26vw, 500px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 48px;
    padding: clamp(64px, 5.2vw, 100px) 0;
    background: var(--mist);
    overflow: hidden;
  }

  :global(.clients__overline) {
    padding: 0 var(--gutter);
  }

  .clients__marquee {
    display: flex;
    width: max-content;
    animation: marquee 50s linear infinite;
  }

  @keyframes marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .clients__list {
    display: flex;
    flex: none;
    padding-left: var(--gutter);
  }

  .clients__list li {
    display: flex;
    align-items: center;
    gap: 64px;
    padding-right: 64px;
    white-space: nowrap;
  }

  .clients__name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(28px, 2.3vw, 44px);
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.55;
    transition: opacity 0.3s;
  }

  .clients__name:hover {
    opacity: 1;
  }

  .clients__plus {
    font-weight: 600;
    font-size: clamp(28px, 2.3vw, 44px);
    line-height: 1.3;
    color: var(--sun);
  }

  @media (max-width: 767px) {
    .clients__list li {
      gap: 32px;
      padding-right: 32px;
    }
  }
</style>
