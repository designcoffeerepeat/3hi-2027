---
import Button from './Button.astro';

// Hero and the Shopify spotlight share one pinned stage. On scroll the
// 'xt - 1' clock grows, its black arm floods the screen and the spotlight
// builds up on top (see "Hero to Section-Shopify" storyboard on the Mood page).
interface Props {
  hero: any;
  spotlight: any;
}
const { hero, spotlight } = Astro.props;
const heroWords = hero.title.split(' ');
---
<section class="story" id="top" data-story aria-label="Introduction">
  <div class="story__sticky">
    <!-- Big '3' from the Home - 2 design. Its gradient slowly turns over,
         so the cyan and yellow ends trade places and come back. -->
    <div class="story__three" data-hero-three aria-hidden="true">
      <svg viewBox="388 -4 1031 1265" fill="none">
        <defs>
          <linearGradient id="three-grad" gradientUnits="objectBoundingBox" x1="0" y1="0.5" x2="1" y2="0.5">
            <stop offset="0" stop-color="#00D0FF" />
            <stop offset="0.495" stop-color="#F7C7FF" />
            <stop offset="1" stop-color="#FFD600" />
            <animateTransform attributeName="gradientTransform" type="rotate" values="0 0.5 0.5;90 0.5 0.5;180 0.5 0.5;270 0.5 0.5;360 0.5 0.5" dur="36s" repeatCount="indefinite" />
          </linearGradient>
        </defs>
        <path d="M535.846 1027.94L632.102 931.262L645.144 938.556C732.744 987.53 906.789 1076.1 1020.93 1076.1L1039.4 1075.87L1119.27 1072.63L1059.830 1111.65C1011.47 1143.02 947.3 1159.23 869.741 1159.23C780.295 1159.23 635.334 1078.42 560.199 1040.09L535.846 1027.94ZM952.494 645.404L916.022 641.93L993.004 546.413H1008.35C1262.5 546.413 1300.47 679.79 1300.47 759.099L1286.39 836.439L1267.46 884.834L1249.57 836.092C1210.21 727.375 1104.61 659.529 952.494 645.404ZM714.739 180.667L800.723 94.4121H1238.61L1168.43 180.667H714.739ZM868.587 1261C1076.8 1253.01 1213.91 1172.43 1254.42 1034.31L1256.73 1026.55L1264 1022.73C1364.06 967.964 1419 873.951 1419 757.941C1419 587.977 1304.16 479.84 1104.03 461.315L1067.79 457.61L1374.91 77.0452V-4H760.097L577.511 179.278L587.552 278.732H1087.07L788.028 647.14V731.08H856.699C1109.8 731.08 1148.35 863.184 1148.93 941.682V956.733L1134.27 960.785C1100.34 969.932 1062.02 974.563 1020.7 974.563C896.402 974.563 714.97 872.793 632.102 803.789L630.948 802.631L626.101 798L388 1037.2C439.706 1079 674.69 1268.29 868.587 1260.77Z" fill="url(#three-grad)" />
      </svg>
    </div>
    <!-- Phones: three soft colour glows instead of the drifting sun -->
    <div class="story__glow" aria-hidden="true"><span></span><span></span><span></span></div>
    <canvas class="story__gl" data-story-gl aria-hidden="true"></canvas>
    <!-- Names the horizon of the clock arm under the pointer (main.ts) -->
    <p class="xt-label" data-xt-label data-labels={JSON.stringify(hero.horizons)} aria-hidden="true">
      <span class="xt-label__num mono" data-xt-num></span>
      <span class="xt-label__name" data-xt-name></span>
    </p>
    <ul class="visually-hidden">
      {hero.horizons.map((h: string) => <li>{h}</li>)}
    </ul>
    <!-- Fallback art for no WebGL or reduced motion -->
    <div class="story__fallback" aria-hidden="true">
      <span class="story__fallback-sun"></span>
    </div>

    <div class="hero" data-hero>
      <h1 class="hero__title">
        {hero.overline && <span class="hero__overline mono">{hero.overline}</span>}
        {heroWords.map((w: string, i: number) => (
          <span class="hero__line" style={`--i:${i}`}><span class:list={{ 'hero__mark': w === hero.highlight }}>{w}</span></span>
        ))}
      </h1>
      <div class="hero__copy" data-hero-copy>
        <p class="hero__kicker">{hero.kicker}</p>
        <p class="hero__text">{hero.text}</p>
        <Button href={hero.button.href} label={hero.button.label} />
      </div>
      <a class="hero__down" href="#work-title" aria-label={hero.scrollLabel} data-hero-down>
        {hero.arrowLabel && <span class="hero__down-label mono" aria-hidden="true">{hero.arrowLabel}</span>}
        <svg viewBox="0 0 44 99" fill="none" aria-hidden="true">
          <path d="M21.7731 1.5L21.7731 97.5M2.12126 77.8484L21.7731 97.5L41.4248 77.8485" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <div class="spot" data-spot>
      <div class="spot__stage" data-spot-stage>
        <div class="spot__clouds spot__clouds--back" data-spot-clouds="0.8">
          <img class="spot__cloud spot__cloud--2" src={spotlight.clouds} alt="" width="2000" height="1122" loading="eager" decoding="async" />
        </div>
        <div class="spot__clouds" data-spot-clouds="1">
          <img class="spot__cloud spot__cloud--1" src={spotlight.clouds} alt="" width="2000" height="1122" loading="eager" decoding="async" />
        </div>
        <span class="spot__sun" data-spot-sun aria-hidden="true"></span>
        <p class="spot__overline mono" data-spot-overline>{spotlight.overline}</p>
        <div class="spot__model" data-spot-model>
          <img src={spotlight.image} alt={spotlight.imageAlt} width="1382" height="1437" loading="eager" decoding="async" />
        </div>
        <div class="spot__clouds spot__clouds--front" data-spot-clouds="1.25">
          <img class="spot__cloud spot__cloud--3" src={spotlight.clouds} alt="" width="2000" height="1122" loading="eager" decoding="async" />
        </div>
        <h2 class="spot__title" data-spot-title>
          {spotlight.title.split('').map((c: string, i: number) => <span style={`--i:${i}`}>{c}</span>)}
        </h2>
        <div class="spot__text" data-spot-text>
          {spotlight.heading && <h3 class="spot__heading">{spotlight.heading}</h3>}
          <p>{spotlight.text}</p>
          {spotlight.button && <Button href={spotlight.button.href} label={spotlight.button.label} variant="yellow" class="spot__btn" />}
        </div>
      </div>
    </div>
  </div>
</section>
<div class="spot-after">
  {spotlight.heading && <p class="spot__heading">{spotlight.heading}</p>}
  <p>{spotlight.text}</p>
  {spotlight.button && <Button href={spotlight.button.href} label={spotlight.button.label} variant="yellow" />}
</div>

<style>
  .story {
    /* 1 design pixel on the 1920 x 1080 artboard */
    --u: min(calc(100vw / 1920), calc(100svh / 1080));
    /* Wider than 16:9: JS raises this (up to 1.35) so the hero text grows
       into the extra width instead of staying sized to the height. */
    --wide: 1;
    position: relative;
    height: 520svh;
    background: var(--paper);
  }

  .story__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .story__gl,
  .story__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .story__fallback {
    display: none;
  }

  /* Artboard: x 845 to 1876, y -4 to 1261, 25% opacity, behind the sun */
  .story__three {
    position: absolute;
    /* Grows a little with the hero text on screens wider than 16:9 */
    --s: calc(1 + (var(--wide) - 1) * 0.6);
    left: calc(50% - 115 * var(--u) * var(--s));
    top: calc(50svh - 544 * var(--u));
    width: calc(1031 * var(--u) * var(--s));
    opacity: 0.25;
    pointer-events: none;
  }

  .story__glow {
    display: none;
  }

  .story__three svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .no-webgl .story__gl {
    display: none;
  }

  /* Label that names the hovered clock arm */
  .xt-label {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 22px 16px;
    border-radius: 18px;
    background: var(--ink);
    color: var(--paper);
    pointer-events: none;
    opacity: 0;
    scale: 0.92;
    transform-origin: 0 100%;
    transition:
      opacity 0.3s,
      scale 0.4s var(--ease-out);
    white-space: nowrap;
  }

  .xt-label.is-on {
    opacity: 1;
    scale: 1;
  }

  .xt-label__num {
    color: var(--sun);
    font-size: 11px;
  }

  .xt-label__name {
    font-weight: 600;
    font-size: clamp(20px, 1.5vw, 30px);
    line-height: 1;
    text-transform: uppercase;
  }

  .no-webgl .story__fallback {
    display: block;
    background:
      url('/images/xt.svg') center 58% / min(34vw, 61svh) no-repeat;
  }

  .story__fallback-sun {
    position: absolute;
    left: -10vw;
    bottom: -40vw;
    width: 60vw;
    height: 60vw;
    border-radius: 50%;
    background: radial-gradient(circle at 25% 75%, #ff975e, #ffd600 48%, #ffc5fe);
    filter: blur(80px);
    opacity: 0.5;
  }

  /* Hero */
  .hero {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .hero__title {
    position: absolute;
    left: max(calc(66 * var(--u)), var(--gutter));
    top: calc(50svh - 540 * var(--u) + 302 * var(--u));
    width: calc(862 * var(--u) * var(--wide));
    font-weight: 600;
    /* --title-fit (JS) shrinks the type when it would reach the clock */
    font-size: calc(155 * var(--u) * var(--wide) * var(--title-fit, 1));
    line-height: 0.75;
    text-transform: uppercase;
  }

  .hero__overline {
    position: absolute;
    left: 0;
    bottom: calc(100% + max(calc(36 * var(--u)), 16px));
    font-size: max(calc(15 * var(--u)), 11px);
    font-weight: 400;
    white-space: nowrap;
    opacity: 0;
    animation: fade-in 1.2s var(--ease-out) 0.3s forwards;
  }

  /* Highlighted word: yellow block behind it, as in Home - 2 */
  .hero__mark {
    background: linear-gradient(var(--sun), var(--sun)) 0 0.06em / 100% 0.86em no-repeat;
    padding-inline: 0.03em;
    margin-inline: -0.03em;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-top: 0.12em;
    margin-top: -0.12em;
  }

  .hero__line > span {
    display: inline-block;
    transform: translate3d(0, 105%, 0);
    animation: line-up 1.2s var(--ease-out) forwards;
    animation-delay: calc(0.15s + var(--i) * 0.09s);
  }

  @keyframes line-up {
    to {
      transform: none;
    }
  }

  .hero__copy {
    position: absolute;
    right: max(calc(84 * var(--u)), var(--gutter));
    top: calc(50svh - 540 * var(--u) + 500 * var(--u));
    width: min(max(calc(419 * var(--u) * var(--wide)), 300px), var(--copy-max, 100vw));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(50 * var(--u));
    font-size: max(calc(20 * var(--u) * var(--wide)), 15px);
    line-height: 2;
  }

  .hero__copy > :global(*) {
    opacity: 0;
    animation: fade-in 1.2s var(--ease-out) 0.6s forwards;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* A slimmer pill than the default button, as in the design (52px tall) */
  .hero__copy :global(.btn) {
    padding: clamp(14px, 0.95vw, 18px) 30px clamp(14px, 0.95vw, 18px) 34px;
  }

  .hero__kicker {
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .hero__down {
    position: absolute;
    left: max(calc(66 * var(--u)), var(--gutter));
    /* Just below the title, which grows on wide screens */
    top: calc(50svh - 540 * var(--u) + (352 + 349 * var(--wide) * var(--title-fit, 1)) * var(--u));
    display: grid;
    place-items: center;
    width: max(calc(64 * var(--u)), 44px);
    padding: 8px;
    margin-left: -8px;
    color: var(--ink);
  }

  .hero__down {
    gap: 14px;
  }

  .hero__down-label {
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-size: 10px;
    white-space: nowrap;
    animation: fade-in 1.2s var(--ease-out) 1s both;
  }

  .hero__down svg {
    width: 100%;
    height: auto;
    animation:
      fade-in 1.2s var(--ease-out) 1s both,
      bob 2.4s ease-in-out 2.2s infinite;
  }

  .hero__down:hover svg {
    animation-play-state: paused;
    translate: 0 8px;
    transition: translate 0.4s var(--ease-out);
  }

  @keyframes bob {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 10px;
    }
  }

  /* Spotlight / Shopify */
  .spot {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--ink);
    color: var(--paper);
    visibility: hidden;
    opacity: 0;
  }

  /* Laid out on the 1080 tall artboard. JS sets its width to fill the
     screen at the current scale, so ultrawide and 4:3 screens keep every
     element in view: centre pieces stay centred, the rest hug an edge. */
  .spot__stage {
    /* On stages narrower than the 1920 artboard the sun and model slide
       left a little so the paragraph on the right stays on black. */
    --shift: max(0px, (1920px - var(--stage-w, 1920px)) * 0.35);
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--stage-w, 1920px);
    height: var(--stage-h, 1080px);
    transform: translate(-50%, -50%) scale(var(--stage-scale, 1));
  }

  .spot__sun {
    position: absolute;
    left: calc(50% - 400px - var(--shift));
    top: -400px;
    width: 800px;
    height: 800px;
    border-radius: 50%;
    background: radial-gradient(circle at 23.9% 88.2%, #ff975e 0%, #ffd600 40.4%, #ffc5fe 84.1%);
    z-index: 1;
  }

  .spot__clouds {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .spot__clouds--front {
    z-index: 3;
  }

  .spot__cloud {
    position: absolute;
    max-width: none;
    height: auto;
    pointer-events: none;
  }

  .spot__cloud--2 {
    left: calc(50% - 1367px);
    bottom: -574px;
    width: 2111px;
    opacity: 0.5;
    transform: scaleX(-1);
  }

  .spot__cloud--1 {
    left: calc(50% - 988px);
    bottom: -542px;
    width: 2443px;
  }

  .spot__cloud--3 {
    left: calc(50% - 1010px);
    bottom: -656px;
    width: 1623px;
  }

  .spot__overline {
    position: absolute;
    left: max(65px, calc(50% - 1180px));
    bottom: 586px;
    z-index: 2;
    color: var(--sun);
  }

  .spot__model {
    position: absolute;
    left: calc(50% - 470px - var(--shift));
    bottom: -17px;
    width: 981px;
    height: 1037px;
    z-index: 2;
  }

  .spot__model img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .spot__title {
    position: absolute;
    left: max(42px, calc(50% - 1200px));
    bottom: 303px;
    z-index: 4;
    font-weight: 400;
    font-size: 300px;
    line-height: 0.75;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--paper);
    mix-blend-mode: exclusion;
  }

  .spot__title span {
    display: inline-block;
  }

  .spot__text {
    position: absolute;
    right: max(45px, calc(50% - 1200px));
    top: 140px;
    width: clamp(360px, calc(449px - var(--shift) / 2), 449px);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
    font-size: 20px;
    line-height: 2;
    color: var(--paper);
  }

  .spot__heading {
    font-weight: 600;
    font-size: 20px;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .spot__text :global(.spot__btn) {
    margin-top: 10px;
    padding: 18px 30px 18px 34px;
  }

  .spot-after {
    display: none;
  }

  /* Tablet and phone: laid out as 'Home - Mobile' in Figma (390 wide) */
  @media (max-width: 899px) {
    /* Shorter run than desktop so the clock hands off to the
       spotlight after less scrolling */
    .story {
      height: 300svh;
    }

    .story__glow {
      display: block;
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .story__glow span {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
    }

    .story__glow span:nth-child(1) {
      left: 51vw;
      top: 150px;
      width: 77vw;
      height: 67vw;
      background: rgb(153 224 255 / 0.45);
    }

    .story__glow span:nth-child(2) {
      left: 31vw;
      top: 420px;
      width: 97vw;
      height: 97vw;
      background: rgb(250 191 242 / 0.45);
    }

    .story__glow span:nth-child(3) {
      left: -36vw;
      bottom: -10svh;
      width: 92vw;
      height: 77vw;
      background: rgb(255 214 51 / 0.55);
    }

    .hero__title {
      left: var(--gutter);
      right: var(--gutter);
      top: max(143px, calc(var(--header-h) + 47px));
      width: auto;
      /* sized so the longest word ("Customers.") fits the phone width */
      font-size: clamp(40px, min(14vw, 8.5svh), 120px);
    }

    .hero__overline {
      bottom: calc(100% + 14px);
    }

    .story__three {
      left: 38.5vw;
      top: 210px;
      width: 95vw;
      opacity: 0.22;
    }

    .hero__down {
      display: none;
    }

    .hero__copy {
      left: var(--gutter);
      right: var(--gutter);
      top: auto;
      bottom: max(3svh, 24px);
      width: auto;
      gap: 20px;
      font-size: 16px;
      line-height: 1.8;
    }

    /* Spotlight: the 390 x 549 frame, scaled to the phone's width by main.ts
       and sitting on the foot of the screen so it runs straight into the
       text below. The sun shows whole in the black above. */
    .spot__stage {
      top: auto;
      bottom: 0;
      width: 390px;
      height: 549px;
      transform: translateX(-50%) scale(var(--m-scale, 1));
      transform-origin: 50% 100%;
    }

    .spot__clouds {
      z-index: 3;
    }

    .spot__clouds--back {
      display: none;
    }

    .spot__cloud,
    .spot__overline,
    .spot__title {
      bottom: auto;
    }

    .spot__sun {
      left: 20px;
      top: -239px;
      width: 350px;
      height: 350px;
    }

    .spot__cloud--1 {
      left: -260px;
      top: 226px;
      width: 900px;
    }

    .spot__cloud--3 {
      left: -60px;
      top: 346px;
      width: 700px;
    }

    /* Overline and title sit across the middle of the person */
    .spot__overline {
      left: 30px;
      right: auto;
      top: 260px;
      width: 330px;
      font-size: 12px;
      line-height: 1;
      letter-spacing: 0.2em;
      text-align: center;
      white-space: normal;
      z-index: 5;
    }

    .spot__model {
      left: -50px;
      top: 36px;
      bottom: auto;
      width: 480px;
      height: 507px;
    }

    .spot__title {
      left: 0;
      right: 0;
      top: 296px;
      font-size: 80px;
      line-height: 0.95;
      letter-spacing: 0.05em;
      text-align: center;
    }

    .spot__text {
      display: none;
    }

    .spot-after {
      display: block;
      background: var(--ink);
      color: var(--paper);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      padding: 60px var(--gutter) 48px;
      font-size: 16px;
      line-height: 1.8;
    }

    .spot-after .spot__heading {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line > span,
    .hero__down,
    .hero__down svg,
    .hero__copy > :global(*) {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }
</style>
