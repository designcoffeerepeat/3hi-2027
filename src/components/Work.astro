---
import Button from './Button.astro';
import Overline from './Overline.astro';
import CaseCard from './CaseCard.astro';

interface Props {
  work: any;
  cards: any[];
}
const { work, cards } = Astro.props;
---
<section class="section work" aria-labelledby="work-title">
  <div class="work__head">
    <div class="work__intro">
      <Overline text={work.overline} />
      <h2 id="work-title" class="display-xl work__title" data-reveal data-speed="0.06">{work.title}</h2>
    </div>
    <div class="work__aside" data-reveal style="--reveal-delay:150ms">
      <p>{work.text}</p>
      <Button href={work.button.href} label={work.button.label} />
    </div>
  </div>
  <div class="work__grid">
    {cards.map((c: any, i: number) => <CaseCard card={c} delay={(i % 2) * 120} />)}
  </div>
</section>

<style>
  .work__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding: clamp(80px, 7.3vw, 140px) var(--gutter) clamp(48px, 4.2vw, 80px);
  }

  .work__intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  .work__title {
    font-size: clamp(48px, 6.77vw, 130px);
    max-width: 9.6em;
  }

  .work__aside {
    flex: 0 0 min(460px, 32vw);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 36px;
  }

  .work__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 899px) {
    .work__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .work__aside {
      flex: none;
      width: 100%;
      max-width: 520px;
    }

    .work__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
